{
  "model_name": "qwen3:8b",
  "llm_think": false,
  "llm_num_predict": 120,
  "llm_num_ctx": 4096,
  "llm_temperature": 0.6,
  "stt_model": "small",
  "stt_language": "auto",
  "stt_online_fallback": false,
  "stt_capture": "classic",
  "listening_mode": "wake_word",
  "wake_words": ["dream"],
  "voice_lang_bn": "bn",
  "voice_lang_en": "en",
  "pause_threshold": 1.5,
  "phrase_threshold": 0.3,
  "energy_threshold_floor": 100,
  "energy_threshold_ceiling": 250,
  "dynamic_energy_threshold": false,
  "barge_in_enabled": true,
  "barge_in_baseline_s": 0.6,
  "barge_in_multiplier": 2.0,
  "barge_in_margin": 40,
  "barge_in_confirm_ms": 500,
  "hud_opacity": 0.85,
  "hud_position": "top-right",
  "memory_path": "sopno/memory/memory.db",
  "memory_max_tokens": 400,
  "memory_recall_limit": 8,
  "semantic_memory_enabled": true,
  "semantic_recall_limit": 4,
  "reminders_enabled": true,
  "reminders_poll_seconds": 30,
  "reminders_max": 50,
  "reminders_max_horizon_days": 365,
  "reminders_path": "sopno/memory/reminders.db",
  "browser_enabled": true,
  "browser_allowed_domains": [
    "wikipedia.org",
    "duckduckgo.com",
    "python.org",
    "github.com",
    "example.com",
    "en.wikipedia.org"
  ],
  "browser_timeout": 30,
  "browser_task_limit": 120,
  "browser_headless": true,
  "mcp_enabled": true,
  "mcp_servers": {},
  "plugins_enabled": true,
  "plugins_dir": "plugins",
  "desktop_enabled": true,
  "desktop_allowed_apps": [],
  "desktop_require_x11": true,
  "database_enabled": true,
  "packages_enabled": true,
  "packages_uninstall_allowed": false,
  "packages_require_sudo": true,
  "network_enabled": true,
  "network_public_ip_enabled": false,
  "vision_enabled": false,
  "vision_model": "",
  "email_enabled": false,
  "email_imap_server": "",
  "email_imap_port": 993,
  "email_smtp_server": "",
  "email_smtp_port": 587,
  "email_user": "",
  "email_from": "",
  "email_password_env": "SOPNO_EMAIL_PASSWORD",
  "calendar_dir": "sopno/memory/calendar",
  "notes_dir": "sopno/memory/notes",
  "rules_enabled": true,
  "rules_path": "sopno/memory/rules.db",
  "rules_poll_seconds": 60,
  "subagents_enabled": true,
  "subagents_max_turns": 4,
  "agents_enabled": true,
  "agents_path": "sopno/memory/agents.db",
  "agents_max_sessions": 20,
  "agents_concurrency": 2,
  "agents_lease_seconds": 300,
  "agents_backoff_base": 5,
  "agents_backoff_cap": 3600,
  "agents_max_attempts": 3,
  "agents_poll_seconds": 30,
  "agents_worker_poll_seconds": 2,
  "agents_job_max_turns": 20,
  "agents_watchdog_seconds": 300,
  "agents_file_watches": [],
  "agents_file_poll_seconds": 10,
  "agents_webhook_host": "127.0.0.1",
  "agents_webhook_port": 0,
  "coding_enabled": true,
  "coding_worktree_dir": "sopno/memory/worktrees",
  "coding_max_turns": 150,
  "coding_max_tokens": 300000,
  "coding_max_wall_minutes": 120,
  "coding_max_diff_lines": 800,
  "coding_stall_rounds": 6,
  "coding_approval_mode": "review_required",
  "coding_protected_paths": ["config.json", "sopno/memory", ".git"],
  "coding_require_red_test": true,
  "coding_push_enabled": false,
  "research_embed_model": "nomic-embed-text",
  "research_max_pages": 6,
  "research_page_chars": 20000,
  "research_chunk_chars": 1800,
  "research_top_k": 6,
  "research_summary_tokens": 800,
  "research_summary_ctx": 8192,
  "terminal_enabled": true,
  "terminal_shell": "/bin/bash",
  "terminal_timeout": 30,
  "terminal_max_timeout": 300,
  "terminal_output_chars": 4000,
  "terminal_blocklist": [
    "shutdown", "reboot", "halt", "poweroff", "init 0", "init 6",
    "rm -rf /", "rm -fr /", "rm -rf /*", "rm -fr /*",
    "rm -rf ~", "rm -fr ~", "sudo rm -rf /",
    "mkfs", "fdisk", "parted", "mkpart", "mkswap",
    "fork bomb", ":(){",
    "chmod -R 777 /", "chmod 777 /",
    "> /dev/sda", "> /dev/sdb", "> /dev/sdc", "> /dev/sdd",
    "of=/dev/sda", "of=/dev/sdb", "of=/dev/sdc"
  ],
  "file_enabled": true,
  "file_allowed_read": ["."],
  "file_allowed_write": ["."],
  "file_blocked_paths": [
    ".env", ".env.*", ".env.local", ".git", ".ssh", ".gnupg",
    ".netrc", ".aws", "id_rsa", "id_dsa", "id_ecdsa",
    "id_ed25519", "*.pem", "*.key", "credentials.json",
    "service-account.json", "*.secret", "*.keychain",
    "config.json", "sopno/memory/memory.db"
  ],
  "file_max_size_bytes": 2000000,
  "file_output_chars": 6000,
  "file_confirm_writes": true,
  "file_search_max_results": 50,
  "file_ocr_enabled": true,
  "readers_max_pages": 20,
  "readers_max_chars": 20000,
  "git_enabled": true,
  "git_max_diff_chars": 12000
}
